# Razorpay API Credentials (server-side only)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=whsec_...

# Merchant Credential Envelope Encryption Key (AES-256-GCM, 32-byte hex or high-entropy string, server-side only)
AEGIS_ENCRYPTION_KEY=your_aegis_master_encryption_key_32_bytes_or_hex_string

# LLM API Key (OpenAI compatible, server-side only)
OPENAI_API_KEY=sk-...

# Neon Postgres Connection (Pooled for Prisma client runtime)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Neon Postgres Direct Connection (Unpooled for Prisma migrations)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"
