# ==========================================
# Razorpay Aegis — Comprehensive .gitignore
# ==========================================

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# IDEs and Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.project
.settings/

# Node & Package Managers
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Next.js, Turbopack, Bundlers & Build Outputs
.next/
/.next/
out/
/out/
build/
/build/
dist/
/dist/
.turbo/
.cache/

# Testing & Coverage
coverage/
/coverage
.nyc_output/
*.lcov

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Environment & Secrets (Never commit .env files with real credentials)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# SQLite & Database Artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
prisma/*.db
prisma/*.db-journal

# SSL & Security Certificates / Keys
*.pem
*.key
*.cert
*.crt

# Temporary, Browser & Scratch Files
*.tmp
*.temp
.temp/
*.log
*.orig
*.bak
chrome/
.local-chromium/
