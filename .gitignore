# ==========================================
# Razorpay Aegis — Production .gitignore
# ==========================================

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# IDEs and Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
.project
.settings/

# AI Agents, Tooling & IDE State
.agents/
.gemini/
.claude/
.cursor/

# Node & Package Managers
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Python & Scratch Scripts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
test_*.py

# Next.js, Turbopack, Bundlers & Build Outputs
.next/
/.next/
out/
/out/
build/
/build/
dist/
/dist/
.turbo/
.cache/

# Testing & Coverage (Vitest / Jest / Playwright)
coverage/
/coverage
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
test-reports/

# TypeScript & Build Cache
*.tsbuildinfo
next-env.d.ts

# Cloud, Vercel & Neon CLI
.vercel/
.vercel
.neon
.neon/

# Environment & Secrets (Never commit credentials)
.env*
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.vercel
!.env.example

# SQLite, Postgres & Database Dumps / Artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.dump
*.sql.gz
prisma/*.db
prisma/*.db-journal

# SSL & Security Certificates / Keys
*.pem
*.key
*.cert
*.crt

# Temporary, Browser & Scratch Files
*.tmp
*.temp
.temp/
*.log
*.orig
*.bak
chrome/
.local-chromium/
scratch/
useful links.md
